        field(DTYP, "Soft Channel")
        field(NOBT, "3")
        field(ZRST, "IDLE")
	field(ONST, "100 mHz")
	field(TWST, "200 mHz")
	field(THST, "500 mHz")
        field(FRST, "1 Hz")
        field(FVST, "2 Hz")
        field(SXST, "5 Hz")
        field(SVST, "10 Hz")
        field(EIST, "20 Hz")
        field(NIST, "50 Hz")
        field(TEST, "100 Hz")

        field(ZRVL, "0")
	# sub hz values in uHz to avoid ambiguity
	field(ONVL, "100000")
	field(TWVL, "200000")
	field(THVL, "500000")
        field(FRVL, "1")
        field(FVVL, "2")
        field(SXVL, "5")
        field(SVVL, "10")
        field(EIVL, "20")
        field(NIVL, "50")
        field(TIVL, "100")

        field(FLNK, "${UUT}:SIG:SOFT_TRIGGER:REPEAT:wz")
}

