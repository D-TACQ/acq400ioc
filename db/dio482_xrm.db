record(longin, "${UUT}:${SITE}:AWG:SAMPLES") {
	
}

record(mbbi, "${UUT}:${SITE}:AWG:STATE") {
	field(DTYP, "stream")
	field(NOBT, "2")
	field(ZRST, "IDLE")
	field(ONST, "ARM")
	field(TWST, "RUN")
	field(INP, "@dio482_xrm.proto get_dwg(${UUT}:${SITE}:AWG:SAMPLES) ${SPORT}")
	field(SCAN, ".1 second")
}

record(mbbo, "${UUT}:${SITE}:DIO:MODE") {
	field(DTYP, "Soft Channel")
	field(NOBT, "2")
	field(ZRST, "OFF")
	field(ONST, "IMM")
	field(TWST, "CLK")
	field(FLNK, "${UUT}:${SITE}:DIO:MODE:w PP")
	field(SDIS, "${UUT}:${SITE}:NOPOLL")
	field(DISV, "1")
}

record(mbbo, "${UUT}:${SITE}:DIO:MODE:w") {
        field(DTYP, "stream")
        field(NOBT, "2")
        field(ZRST, "OFF")
        field(ONST, "IMM")
        field(TWST, "CLK")

        field(SDIS, "${UUT}:${SITE}:DIO:MODE:s.PACT")
        field(DISV, "1")

        field(OMSL, "closed_loop")
        field(DOL,  "${UUT}:${SITE}:DIO:MODE")

        field(OUT, "@dio482_xrm.proto set_mode() ${SPORT}")
        field(FLNK, "${UUT}:${SITE}:DIO:fan")
}

record(mbbi, "${UUT}:${SITE}:DIO:MODE:r") {
        field(DTYP, "stream")
        field(NOBT, "2")
        field(ZRST, "OFF")
        field(ONST, "IMM")
        field(TWST, "CLK")
        field(INP, "@dio482_xrm.proto get_mode() ${SPORT}")
        field(SCAN, "1 second")
        field(FLNK, "${UUT}:${SITE}:DIO:MODE:s")
        field(SDIS, "${UUT}:${SITE}:NOPOLL")
        field(DISV, "1")
}

record(mbbo, "${UUT}:${SITE}:DIO:MODE:s") {
        field(DTYP, "Soft Channel")
        field(NOBT, "2")
        field(ZRST, "OFF")
        field(ONST, "IMM")
        field(TWST, "CLK")
        field(DOL,  "${UUT}:${SITE}:DIO:MODE:r NPP")
        field(OMSL, "closed_loop")
        field(OUT,  "${UUT}:${SITE}:DIO:MODE PP")
}


# force DO's to process as they may be disabled.. from change of OUTPUT
record(fanout, "${UUT}:${SITE}:DIO:fan") {
	field(LNK0, "${UUT}:${SITE}:IMM:DO:BANK1 PP")
	field(LNK1, "${UUT}:${SITE}:IMM:DO:BANK2 PP")
	field(LNK2, "${UUT}:${SITE}:IMM:DO:BANK3 PP")
	field(LNK3, "${UUT}:${SITE}:IMM:DO:BANK4 PP")
	field(LNK4, "${UUT}:${SITE}:IMM:DO:BANK5 PP")
	field(LNK5, "${UUT}:${SITE}:IMM:DO:BANK6 PP")
	field(LNK6, "${UUT}:${SITE}:IMM:DO:BANK7 PP")
	field(LNK7, "${UUT}:${SITE}:IMM:DO:BANK8 PP")
}

record(calcout, "${UUT}:${SITE}:IMM:DO:CALC") {
	field(DTYP, "stream")
	field(OUT,  "@dio482_xrm.proto set_DO32 ${SPORT}")
	field(INPA, "${UUT}:${SITE}:IMM:DO:BANK1 NPP NMS")
	field(INPB, "${UUT}:${SITE}:IMM:DO:BANK2 NPP NMS")
	field(INPC, "${UUT}:${SITE}:IMM:DO:BANK3 NPP NMS")
	field(INPD, "${UUT}:${SITE}:IMM:DO:BANK4 NPP NMS")
	field(INPE, "${UUT}:${SITE}:IMM:DO:BANK5 NPP NMS")
	field(INPF, "${UUT}:${SITE}:IMM:DO:BANK6 NPP NMS")
	field(INPG, "${UUT}:${SITE}:IMM:DO:BANK7 NPP NMS")
	field(INPH, "${UUT}:${SITE}:IMM:DO:BANK8 NPP NMS")
	# Shift everything into a 32-bit word
	field(CALC, "A|(B<<8)|(C<<16)|(D<<24)|(E<<28)|(F<<29)|(G<<30)|(H<<31)")
}

record(longin, "${UUT}:${SITE}:IMM:DI32") {
	field(SCAN, "1 second")
	field(DTYP, "stream")	
	field(INP,  "@dio482_xrm.proto get_DI32 ${SPORT}")	
	field(DESC, "DI32 immediate value")	
	field(PRIO, "LOW")
	field(SDIS, "${UUT}:${SITE}:NOPOLL")
	field(DISV, "1")
}
record(longout, "${UUT}:${SITE}:IMM:DO32") {	
	field(DTYP, "stream")	
	field(OUT,  "@dio482_xrm.proto set_DO32 ${SPORT}")	
	field(DESC, "DO32 immediate value")	
	field(PRIO, "LOW")
}

