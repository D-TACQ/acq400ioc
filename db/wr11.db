# wr11.db : WR site 11 functions


record(stringin, "${UUT}:${SITE}:Si5326:TUNEPHASE:STATUS")
{
	field(DTYP, "stream")
	field(INP,  "@wr.proto getSi5326TP_STATE ${SPORT}")
	field(SCAN, "1 second")
}

record(longin, "${UUT}:11:WRSFP")
{
	field(DTYP, "stream")
	field(INP,  "@wr.proto getWRSFP ${SPORT}")
	field(PINI, "YES")
}

record(stringin, "${UUT}:${SITE}:Si5326:TUNEPHASE:STATE")
{
	field(DTYP, "stream")
	field(INP,  "@wr.proto getSi5326TP_STATE_VALUE ${SPORT}")
	field(SCAN, "I/O Intr")
}

record(bi, "${UUT}:${SITE}:Si5326:TUNEPHASE:OK:r")
{
	field(DESC, "")
	field(DTYP, "stream")
	field(INP,  "@wr.proto getSi5326TP_OK ${SPORT}")
	field(SCAN, "I/O Intr")
	field(ZNAM, "0")
	field(ONAM, "1")
	field(FLNK, "${UUT}:${SITE}:Si5326:TUNEPHASE:OK")
}

record(longin, "${UUT}:0:WR:PPS:LOS") {
	field(FLNK, "${UUT}:${SITE}:Si5326:TUNEPHASE:OK")
}

record(calc, "${UUT}:${SITE}:Si5326:TUNEPHASE:OK")
{
	field(INPA, "${UUT}:${SITE}:Si5326:TUNEPHASE:OK:r")
	field(INPB, "${UUT}:0:WR:PPS:LOS")
	field(CALC, "A && (!B)")
}


record(bi, "${UUT}:${SITE}:Si5326:TUNEPHASE:BUSY")
{
	field(DESC, "Tune Phase Busy")
	field(DTYP, "stream")
	field(INP,  "@wr.proto getSi5326TP_BUSY ${SPORT}")
	field(SCAN, "I/O Intr")
	field(ZNAM, "0")
	field(ONAM, "1")	
}

record(longin, "${UUT}:${SITE}:Si5326:TUNEPHASE:BUSY:STEP")
{
	field(DTYP, "stream")
	field(INP,  "@wr.proto getSi5326TP_BUSY_STEP ${SPORT}")
	field(SCAN, "I/O Intr")
	field(FLNK, "${UUT}:${SITE}:Si5326:TUNEPHASE:BUSY:ACT")
}

record(calc, "${UUT}:${SITE}:Si5326:TUNEPHASE:BUSY:ACT")
{
	field(INPA, "${UUT}:${SITE}:Si5326:TUNEPHASE:BUSY:STEP")
	field(INPB, "${UUT}:${SITE}:Si5326:TUNEPHASE:BUSY")
	field(CALC, "B && (A&1)")
}


record(bo, "${UUT}:${SITE}:Si5326:TUNEPHASE")
{
	field(ONAM, "ON")
	field(ZNAM, "OFF")
	field(DESC, "Enable Tune Phase")
	field(DTYP, "stream")
	field(OUT,  "@wr.proto setSi5326TP ${SPORT}")
}

record(bo, "${UUT}:${SITE}:WRTD_TXI")
{
	field(DESC, "Set WRTD_TXImmediate")
	field(DTYP, "stream")
	field(OUT,  "@wr.proto set_wrtd_txi ${SPORT}")
	field(ZNAM, "1")
	field(ONAM, "0")
}

record(stringout, "${UUT}:${SITE}:WRTD_TXI_ID")
{
	field(DTYP, "stream")
	field(OUT,  "@wr.proto set_wrtd_txi_id ${SPORT}")	
}

record(bo, "${UUT}:${SITE}:WR_RESET")
{
	field(DTYP, "Soft Channel")
	field(DTYP, "Soft Channel")
	field(ZNAM, "RESET OFF")
	field(ONAM, "RESET ON")
	field(HIGH, "2")
	field(FLNK, "${UUT}:${SITE}:WR_RESET:c")
}

record(calcout, "${UUT}:${SITE}:WR_RESET:c"){
	field(INPA, "${UUT}:${SITE}:WR_RESET")
	field(CALC, "A")
	field(OOPT, "When Non-zero")
	field(DOPT, "Use CALC")
	field(OUT,  "${UUT}:${SITE}:WR_RESET:w PP")
}


record(bo, "${UUT}:${SITE}:WR_RESET:w")
{
	field(DTYP, "stream")
	field(OUT,  "@wr.proto set_wr_reset ${SPORT}")
}

record(stringin, "${UUT}:${SITE}:WR_MAC")
{
	field(DTYP, "stream")
	field(INP,  "@wr.proto get_wr_mac ${SPORT}")
	field(SCAN, "I/O Intr")
}

record(longin, "${UUT}:${SITE}:WR_DELAY")
{
	field(DTYP, "stream")
	field(INP,  "@wr.proto get_wr_delay ${SPORT}")
	field(SCAN, "I/O Intr")
}


